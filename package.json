{
  "name": "iconforge",
  "version": "1.0.0",
  "description": "Local CLI that fetches brand SVG icons from theSVG, normalizes them conservatively, and emits stable metadata and a flat icon folder ready for any project.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "iconforge": "dist/cli/index.js"
  },
  "scripts": {
    "icons": "tsx src/cli/index.ts build",
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "sax": "^1.4.1",
    "svgo": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.0",
    "@types/sax": "^1.2.7",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "svg",
    "icons",
    "brand-icons",
    "cli",
    "icon-fetcher",
    "thesvg",
    "svgo",
    "metadata",
    "readme-icons",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/amr-elmahdy/IconForge.git"
  },
  "homepage": "https://github.com/amr-elmahdy/IconForge",
  "bugs": "https://github.com/amr-elmahdy/IconForge/issues",
  "author": "Amr Elmahdy"
}
