{
  "inputFile": "input/icons.txt",
  "outputDir": "output",
  "reportsDir": "reports/runs",
  "cacheDir": "cache",
  "source": {
    "registryUrl": "https://thesvg.org/api/registry.json",
    "iconBaseUrl": "https://thesvg.org/icons",
    "fallbackIconBaseUrl": "https://cdn.jsdelivr.net/gh/glincker/thesvg@main/public/icons",
